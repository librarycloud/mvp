model DepreciationRecord {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  assetId     Int              @map("asset_id") @db.UnsignedInt
  periodId    Int              @map("period_id") @db.UnsignedInt
  amount      Decimal          @db.Decimal(19, 4)
  eventId     Int?             @unique @map("event_id") @db.UnsignedInt
  voucherId   Int?             @unique @map("voucher_id") @db.UnsignedInt
  status      Int              @default(2) @db.UnsignedTinyInt
  createdById Int              @map("created_by") @db.UnsignedInt
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?        @map("deleted_at") @db.DateTime(3)
  asset       FixedAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("DepreciationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  event       AccountingEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  voucher     Voucher?         @relation("DepreciationVoucher", fields: [voucherId], references: [id], onDelete: Restrict)

  @@unique([assetId, periodId])
  @@index([periodId, status])
  @@index([deletedAt])
  @@map("depreciation_records")
}
