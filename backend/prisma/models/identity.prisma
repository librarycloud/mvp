model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(100)
  role         UserRole  @default(ACCOUNTANT)
  status       Int       @default(0) @db.UnsignedTinyInt
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  refreshTokens                RefreshToken[]
  importBatches                ImportBatch[]
  createdVouchers              Voucher[]                 @relation("VoucherCreator")
  reviewedVouchers             Voucher[]                 @relation("VoucherReviewer")
  postedVouchers               Voucher[]                 @relation("VoucherPoster")
  voidedVouchers               Voucher[]                 @relation("VoucherVoider")
  aiSuggestions                AiSuggestion[]
  generatedReports             Report[]
  auditLogs                    AuditLog[]
  maintainedAccounts           Account[]                 @relation("AccountMaintainer")
  maintainedTemplates          ReportTemplate[]          @relation("TemplateMaintainer")
  fixedAssetDisposals          FixedAssetDisposal[]      @relation("FixedAssetDisposalCreator")
  closedPeriods                AccountingPeriod[]        @relation("AccountingPeriodCloser")
  uploadedAttachments          Attachment[]              @relation("AttachmentUploader")
  attachmentRelations          AttachmentRelation[]      @relation("AttachmentRelationCreator")
  accountingEvents             AccountingEvent[]         @relation("AccountingEventCreator")
  fixedAssets                  FixedAsset[]              @relation("FixedAssetCreator")
  depreciationRecords          DepreciationRecord[]      @relation("DepreciationCreator")
  receivables                  Receivable[]              @relation("ReceivableCreator")
  payables                     Payable[]                 @relation("PayableCreator")
  receivableSettlements        ReceivableSettlement[]    @relation("ReceivableSettlementCreator")
  payableSettlements           PayableSettlement[]       @relation("PayableSettlementCreator")
  employees                    Employee[]                @relation("EmployeeCreator")
  salaries                     Salary[]                  @relation("SalaryCreator")
  yearEndClosings              YearEndClosing[]          @relation("YearEndCreator")
  createdReimbursements        Reimbursement[]           @relation("ReimbursementCreator")
  approvedReimbursements       Reimbursement[]           @relation("ReimbursementApprover")
  rejectedReimbursements       Reimbursement[]           @relation("ReimbursementRejecter")
  paidReimbursements           Reimbursement[]           @relation("ReimbursementPayer")
  createdBankReconciliations   BankReconciliation[]      @relation("BankReconciliationCreator")
  completedBankReconciliations BankReconciliation[]      @relation("BankReconciliationCompleter")
  createdBankMatches           BankReconciliationMatch[] @relation("BankMatchCreator")
  confirmedBankDirections      BankTransaction[]         @relation("BankDirectionConfirmer")
  createdArApFollowUps         ArApFollowUp[]            @relation("ArApFollowUpCreator")
  completedArApFollowUps       ArApFollowUp[]            @relation("ArApFollowUpCompleter")

  @@index([deletedAt])
  @@map("users")
}

model CmbFetchConfig {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  configKey        String    @unique @default("GLOBAL") @map("config_key") @db.VarChar(20)
  encryptedPayload String    @map("encrypted_payload") @db.LongText
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  @@index([deletedAt])
  @@map("cmb_fetch_configs")
}

model RefreshToken {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  tokenId        String    @unique @map("token_id") @db.Char(36)
  userId         Int       @map("user_id") @db.UnsignedInt
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([deletedAt])
  @@map("refresh_tokens")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}

model CompanyProfile {
  id                      Int                  @id @default(autoincrement()) @db.UnsignedInt
  name                    String               @db.VarChar(200)
  unifiedSocialCreditCode String               @unique @map("unified_social_credit_code") @db.VarChar(32)
  legalRepresentative     String?              @map("legal_representative") @db.VarChar(100)
  address                 String?              @db.VarChar(500)
  phone                   String?              @db.VarChar(50)
  bankName                String?              @map("bank_name") @db.VarChar(200)
  bankAccount             String?              @map("bank_account") @db.VarChar(100)
  baseCurrency            String               @default("CNY") @map("base_currency") @db.Char(3)
  fiscalYearStartMonth    Int                  @default(1) @map("fiscal_year_start_month") @db.UnsignedTinyInt
  operationMode           CompanyOperationMode @default(SIMPLE) @map("operation_mode")
  createdAt               DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt               DateTime?            @map("deleted_at") @db.DateTime(3)

  @@index([deletedAt])
  @@map("company_profiles")
}

model Account {
  id              Int              @id @default(autoincrement()) @db.UnsignedInt
  code            String           @unique @db.VarChar(32)
  name            String           @db.VarChar(200)
  category        AccountCategory
  normalDirection BalanceDirection @map("normal_direction")
  parentId        Int?             @map("parent_id") @db.UnsignedInt
  level           Int              @db.UnsignedTinyInt
  isLeaf          Boolean          @default(true) @map("is_leaf")
  isEnabled       Boolean          @default(true) @map("is_enabled")
  isSystem        Boolean          @default(false) @map("is_system")
  cashFlowCode    String?          @map("cash_flow_code") @db.VarChar(32)
  sortOrder       Int              @default(0) @map("sort_order")
  maintainedById  Int?             @map("maintained_by_id") @db.UnsignedInt
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?        @map("deleted_at") @db.DateTime(3)

  parent                         Account?                   @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                       Account[]                  @relation("AccountTree")
  maintainedBy                   User?                      @relation("AccountMaintainer", fields: [maintainedById], references: [id], onDelete: SetNull)
  voucherEntries                 VoucherEntry[]
  reportMappings                 ReportItemAccountMapping[]
  reimbursementExpenses          Reimbursement[]            @relation("ReimbursementExpenseAccount")
  reimbursementPayments          Reimbursement[]            @relation("ReimbursementPaymentAccount")
  reimbursementInputTaxes        Reimbursement[]            @relation("ReimbursementInputTaxAccount")
  bankReconciliations            BankReconciliation[]
  fixedAssetDepreciationExpenses FixedAsset[]               @relation("FixedAssetDepreciationExpenseAccount")
  dimensionRules                 AccountDimensionRule[]

  @@index([parentId, sortOrder])
  @@index([category, isEnabled])
  @@index([deletedAt])
  @@map("accounts")
}
