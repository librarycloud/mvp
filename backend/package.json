{
  "name": "china-finance-mvp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "seed:reports": "tsx scripts/seed-reports.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "test:migration": "node scripts/verify-migration.mjs"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sinclair/typebox": "^0.34.52",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "fast-jwt": "^6.2.4",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.12.1",
    "jszip": "^3.10.1",
    "openai": "^6.46.0",
    "pdfkit": "^0.19.1",
    "sm-crypto": "^0.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
